---
import BlogLayout from '../layouts/BlogLayout.astro';
import BlogPostHero from '../components/blog/BlogPostHero.astro';
import BlogContent from '../components/blog/BlogContent.astro';
import { Content } from '../content/legal/privacy.md';

const description =
  'Como tratamos os dados de quem visita o site ou entra em contato com a Altivo Tecnologia.';
---

<BlogLayout title="Privacidade" description={description}>
  <BlogPostHero
    title="Privacidade"
    description={description}
    pubDate={new Date('2026-10-01T12:00:00-03:00')}
    category="Aviso de privacidade"
  />
  <article class="mx-auto max-w-[800px] px-6 py-10 md:py-24" aria-label="Aviso de privacidade">
    <BlogContent>
      <Content />
    </BlogContent>
  </article>
</BlogLayout>
