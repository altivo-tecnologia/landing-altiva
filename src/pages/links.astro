---
import { ArrowUpRight } from '@lucide/astro';
import Icon from '../components/shared/Icon.astro';
import Layout from '../layouts/Layout.astro';

const channels = [
  { label: 'Instagram', icon: 'brand-instagram', href: 'https://instagram.com/altivo.tec/' },
  { label: 'WhatsApp', icon: 'brand-whatsapp', href: 'https://wa.me/5543988519983' },
  { label: 'Site Altivo', icon: 'world', href: '/' },
  { label: 'E-mail', icon: 'mail', href: 'mailto:suporte@altivo.net.br' },
];
const whatsappUrl = 'https://wa.me/5543988519983';
---

<Layout
  title="Links | Altivo Tecnologia"
  description="Agende uma reunião com a Altivo Tecnologia pelo WhatsApp."
>
  <main id="conteudo-principal" tabindex="-1" class="links-page">
    <section class="profile" aria-labelledby="profile-title">
      <img class="profile__mark" src="/favicon.svg" alt="" />
      <p class="profile__handle">@altivo.tec</p>
      <h1 id="profile-title">altivo tecnologia</h1>
      <p class="profile__description">
        Mapeie sua operação, crie processos e softwares personalizados pra aprimorar a jornada da
        sua empresa!
      </p>

      <nav class="channel-links" aria-label="Redes sociais e canais oficiais">
        {
          channels.map((channel) => (
            <a
              class="channel-link"
              href={channel.href}
              aria-label={
                channel.href.startsWith('http')
                  ? `${channel.label} (abre em nova aba)`
                  : channel.label
              }
              title={channel.label}
              target={channel.href.startsWith('http') ? '_blank' : undefined}
              rel={channel.href.startsWith('http') ? 'noreferrer' : undefined}
            >
              <Icon name={channel.icon} size={21} />
            </a>
          ))
        }
      </nav>

      <a
        class="mt-8 flex min-h-[3.25rem] w-full box-border items-center justify-center gap-2 rounded-sm border border-primary bg-primary px-5 py-3 text-[0.95rem] font-bold text-ink no-underline transition-transform hover:-translate-y-0.5 hover:bg-primary-hover hover:shadow-brand active:translate-y-0 active:scale-[0.99] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary motion-reduce:transition-none"
        href={whatsappUrl}
        target="_blank"
        rel="noreferrer"
      >
        Agendar uma reunião
        <span class="sr-only">pelo WhatsApp (abre em nova aba)</span>
        <ArrowUpRight size={18} aria-hidden="true" />
      </a>
      <a
        class="mt-3 flex min-h-[3.25rem] w-full box-border items-center justify-center gap-2 rounded-sm border border-surface/20 bg-surface/[0.03] px-5 py-3 text-[0.95rem] font-bold text-on-canvas-copy no-underline transition-colors hover:border-primary/65 hover:bg-surface/5 hover:text-primary active:scale-[0.99] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary motion-reduce:transition-none"
        href="/blog/"
      >
        Projetos e artigos
        <ArrowUpRight size={18} aria-hidden="true" />
      </a>
      <a
        class="mt-3 flex min-h-[3.25rem] w-full box-border items-center justify-center gap-2 rounded-sm border border-surface/20 bg-surface/[0.03] px-5 py-3 text-[0.95rem] font-bold text-on-canvas-copy no-underline transition-colors hover:border-primary/65 hover:bg-surface/5 hover:text-primary active:scale-[0.99] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary motion-reduce:transition-none"
        href="/"
      >
        Visite nosso site
        <ArrowUpRight size={18} aria-hidden="true" />
      </a>
    </section>
  </main>
</Layout>

<style>
  .links-page {
    display: grid;
    min-height: 100vh;
    min-height: 100dvh;
    place-items: start center;
    padding: clamp(3rem, 8vh, 5rem) 1.5rem 4rem;
    background: var(--color-canvas);
    color: var(--color-on-canvas);
  }

  .profile {
    display: flex;
    width: min(100%, 27rem);
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .profile__mark {
    box-sizing: border-box;
    width: 4.75rem;
    height: 4.75rem;
    padding: 0.5rem;
    border-radius: 0.5rem;
    background: var(--color-surface-soft);
  }

  .profile__handle {
    margin: 0.8rem 0 0.15rem;
    color: var(--color-brand-detail);
    font-size: 0.875rem;
    font-weight: 600;
  }

  h1 {
    margin: 0;
    color: var(--color-on-canvas);
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .profile__description {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .channel-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .channel-link {
    display: grid;
    width: 2.9rem;
    height: 2.9rem;
    place-items: center;
    border: 1px solid var(--color-line-overlay);
    border-radius: 0.5rem;
    background: var(--color-overlay-soft);
    color: var(--color-brand-detail);
    transition:
      border-color 180ms ease,
      color 180ms ease,
      background-color 180ms ease;
  }

  .channel-link:hover {
    border-color: color-mix(in oklch, var(--color-primary) 55%, transparent);
    background: var(--color-overlay-hover);
    color: var(--color-primary-soft);
  }

  .channel-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .channel-link {
      transition: none;
    }
  }
</style>
