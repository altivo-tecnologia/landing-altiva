---
import type { CollectionEntry } from 'astro:content';
import BlogListing from '../../../components/blog/BlogListing.astro';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { BLOG_PAGE_SIZE, getSortedBlogPosts } from '../../../utils/blog';

export async function getStaticPaths() {
  const posts = await getSortedBlogPosts();
  const totalPages = Math.ceil(posts.length / BLOG_PAGE_SIZE);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const currentPage = index + 2;
    const start = (currentPage - 1) * BLOG_PAGE_SIZE;

    return {
      params: { page: String(currentPage) },
      props: {
        posts: posts.slice(start, start + BLOG_PAGE_SIZE),
        currentPage,
        totalPages,
      },
    };
  });
}

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  totalPages: number;
}

const { posts, currentPage, totalPages } = Astro.props;
---

<BlogLayout
  title="Projetos e ideias"
  description="Artigos e projetos da Altivo Tecnologia: tecnologia aplicada à rotina de pequenas e médias empresas."
>
  <BlogListing posts={posts} currentPage={currentPage} totalPages={totalPages} />
</BlogLayout>
