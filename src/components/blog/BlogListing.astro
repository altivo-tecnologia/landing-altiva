---
import type { CollectionEntry } from 'astro:content';
import Container from '../shared/Container.astro';
import ArticleThumbnail from '../shared/ArticleThumbnail.astro';

export interface Props {
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  totalPages: number;
}

const { posts, currentPage, totalPages } = Astro.props;
const previousHref = currentPage === 2 ? '/blog/' : `/blog/pagina/${currentPage - 1}/`;
const nextHref = `/blog/pagina/${currentPage + 1}/`;
---

<section class="bg-surface pb-14 pt-20 text-ink md:pb-28 md:pt-36">
  <Container>
    <header class="pb-14 pt-9 md:pb-20 md:pt-16">
      <h1
        class="max-w-5xl font-display text-[clamp(2.75rem,10vw,4rem)] font-bold leading-[0.98] tracking-[-0.03em] text-balance md:text-[clamp(3.2rem,7.5vw,6rem)] md:leading-[0.94]"
      >
        {currentPage > 1 && <span>Página {currentPage}: </span>}
        Projetos e escolhas altivas<span class="text-primary">.</span>
      </h1>
      <p
        class="mt-6 max-w-[55rem] text-lg leading-[1.55] text-copy-strong md:mt-10 md:text-2xl md:leading-[1.5]"
      >
        Notas sobre o nosso trabalho, onde a tecnologia se encaixou na rotina.
      </p>
    </header>

    {
      posts.length > 0 ? (
        <div class="divide-y divide-line border-y border-line">
          {posts.map((post) => (
            <article class="py-7 md:py-10">
              <a
                href={`/blog/${post.id}`}
                class="group grid w-full grid-cols-1 items-center gap-10 md:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] md:gap-12 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
              >
                <ArticleThumbnail
                  image={post.data.heroImage}
                  title={post.data.title}
                  sizes="(max-width: 768px) calc(100vw - 3rem), 320px"
                />
                <div class="min-w-0">
                  <h2 class="font-display text-2xl font-bold leading-tight transition-colors group-hover:underline group-hover:decoration-primary group-hover:decoration-2 group-hover:underline-offset-4 md:text-4xl">
                    {post.data.title}
                  </h2>
                  <p class="mt-3 text-base leading-relaxed text-copy md:text-lg">
                    {post.data.description}
                  </p>
                </div>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="border-t border-line py-8 text-lg text-copy">
          Novos textos serão publicados aqui.
        </p>
      )
    }

    {
      totalPages > 1 && (
        <nav
          class="mt-8 flex items-center justify-between gap-4 pt-6 text-sm font-semibold md:mt-10 md:pt-8"
          aria-label="Paginação do blog"
        >
          <div class="min-w-24">
            {currentPage > 1 && (
              <a
                href={previousHref}
                rel="prev"
                class="inline-flex min-h-11 items-center text-copy-strong underline decoration-line-muted underline-offset-4 transition-colors hover:decoration-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
              >
                ← Anterior
              </a>
            )}
          </div>
          <p class="text-center text-copy-muted" aria-current="page">
            Página {currentPage} de {totalPages}
          </p>
          <div class="min-w-24 text-right">
            {currentPage < totalPages && (
              <a
                href={nextHref}
                rel="next"
                class="inline-flex min-h-11 items-center text-copy-strong underline decoration-line-muted underline-offset-4 transition-colors hover:decoration-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
              >
                Próxima →
              </a>
            )}
          </div>
        </nav>
      )
    }
  </Container>
</section>
