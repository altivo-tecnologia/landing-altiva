---
import type { CollectionEntry } from 'astro:content';
import { getRecentPosts } from '../../utils/blog';

export interface Props {
  currentPost: CollectionEntry<'blog'>;
  allPosts: CollectionEntry<'blog'>[];
  limit?: number;
  title?: string;
}

const { currentPost, allPosts, limit = 3, title = 'Continue a leitura' } = Astro.props;
const relatedPosts = getRecentPosts(currentPost, allPosts, limit);
---

<section class="bg-surface py-14 text-ink md:py-28" aria-labelledby="related-title">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <h2
        id="related-title"
        class="font-display text-[clamp(2.75rem,7.5vw,4.5rem)] font-bold leading-[0.98] tracking-[-0.03em] md:leading-[0.94]"
      >
        {title}
      </h2>
      <a
        href="/blog/"
        class="inline-flex min-h-11 w-fit items-center border-b border-ink text-sm font-bold uppercase tracking-[0.12em] transition-colors hover:border-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
      >
        Ver projetos e textos
      </a>
    </div>

    {
      relatedPosts.length > 0 ? (
        <div class="mt-8 divide-y divide-line border-y border-line md:mt-16">
          {relatedPosts.map((post) => (
            <article class="py-7 md:py-10">
              <a
                href={`/blog/${post.id}`}
                class="group block w-full max-w-3xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
              >
                <h3 class="font-display text-2xl font-bold leading-tight transition-colors group-hover:underline group-hover:decoration-primary group-hover:decoration-2 group-hover:underline-offset-4 md:text-4xl">
                  {post.data.title}
                </h3>
                <p class="mt-3 text-base leading-relaxed text-copy md:text-lg">
                  {post.data.description}
                </p>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="mt-12 border-t border-line pt-8 text-lg text-copy">
          Novos textos serão publicados aqui.
        </p>
      )
    }
  </div>
</section>
