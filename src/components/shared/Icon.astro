---
import {
  AtSign,
  ArrowDown,
  ArrowRight,
  ArrowUp,
  Badge,
  Bookmark,
  BriefcaseBusiness,
  Building,
  Calendar,
  Check,
  ChevronDown,
  ChevronRight,
  CircleX,
  Clock,
  Cookie,
  Copyright,
  Database,
  Download,
  Eye,
  FileCheck,
  FileText,
  Gavel,
  Globe,
  Hand,
  Heart,
  Info,
  Link,
  List,
  Lock,
  Mail,
  MapPin,
  Menu,
  MessageCircle,
  Minus,
  PanelsTopLeft,
  Phone,
  Plus,
  Scale,
  Search,
  Send,
  Settings,
  Share,
  Shield,
  ShieldCheck,
  UserCheck,
  Users,
  X,
} from '@lucide/astro';

export interface Props {
  name: string;
  class?: string;
  size?: number;
}

const { name, class: className = '', size = 24 } = Astro.props;
const brandIcon =
  name === 'brand-instagram' ? 'instagram' : name === 'brand-whatsapp' ? 'whatsapp' : undefined;

const icons = {
  bookmark: Bookmark,
  mail: Mail,
  phone: Phone,
  map: MapPin,
  'arrow-right': ArrowRight,
  arrowUp: ArrowUp,
  arrowDown: ArrowDown,
  menu: Menu,
  search: Search,
  close: X,
  download: Download,
  share: Share,
  globe: Globe,
  world: Globe,
  architecture: Building,
  heart: Heart,
  calendar: Calendar,
  location: MapPin,
  send: Send,
  check: Check,
  chevronDown: ChevronDown,
  chevronRight: ChevronRight,
  plus: Plus,
  minus: Minus,
  'arrow-narrow-right': ArrowRight,
  'chevron-down': ChevronDown,
  'brand-linkedin': BriefcaseBusiness,
  'brand-behance': PanelsTopLeft,
  'brand-twitter': AtSign,
  'brand-facebook': Users,
  link: Link,
  eye: Eye,
  'map-pin': MapPin,
  copyright: Copyright,
  clock: Clock,
  'file-check': FileCheck,
  users: Users,
  shield: Shield,
  scale: Scale,
  'circle-x': CircleX,
  'shield-lock': ShieldCheck,
  'file-text': FileText,
  'info-circle': Info,
  database: Database,
  settings: Settings,
  cookie: Cookie,
  list: List,
  contract: FileCheck,
  gavel: Gavel,
  'message-circle': MessageCircle,
  'arrow-up': ArrowUp,
  lock: Lock,
  badge: Badge,
  checkmark: Check,
  'user-check': UserCheck,
  'hand-click': Hand,
} as const;

const IconComponent = icons[name as keyof typeof icons];

if (!IconComponent && !brandIcon) {
  console.warn(`Icon "${name}" not found`);
  return null;
}
---

{
  brandIcon === 'instagram' ? (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none" />
    </svg>
  ) : brandIcon === 'whatsapp' ? (
    <span
      class={className}
      style={`display:inline-block;width:${size}px;height:${size}px;background-color:currentColor;-webkit-mask:url('/whatsapp.svg') center / contain no-repeat;mask:url('/whatsapp.svg') center / contain no-repeat`}
      aria-hidden="true"
    />
  ) : (
    <IconComponent class={className} width={size} height={size} aria-hidden="true" />
  )
}
