---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata | string;
  title: string;
  className?: string;
  sizes?: string;
}

const { image, title, className = '', sizes = '100vw' } = Astro.props;
---

<div
  class={`article-thumbnail aspect-video w-full overflow-hidden ${className}`}
  aria-hidden="true"
>
  {
    image ? (
      typeof image === 'string' ? (
        <img
          src={image}
          alt=""
          class="article-cover h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <Image
          src={image}
          alt=""
          class="article-cover h-full w-full object-cover"
          loading="lazy"
          decoding="async"
          format="webp"
          widths={[400, 600, 800]}
          sizes={sizes}
          quality={80}
        />
      )
    ) : (
      <span class="flex h-full items-center justify-center font-serif text-7xl text-primary">
        {title.slice(0, 1)}
      </span>
    )
  }
</div>

<style>
  .article-thumbnail {
    position: relative;
    border: 3px solid var(--color-line-dark);
    background: var(--color-canvas);
  }

  .article-thumbnail::after {
    position: absolute;
    inset: 1px;
    background: var(--color-canvas);
    content: '';
    mix-blend-mode: color;
    pointer-events: none;
    transition: opacity 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .article-cover {
    filter: grayscale(1) contrast(1.08) brightness(1.2);
    transition: filter 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.group:is(:hover, :focus-visible)) .article-cover {
    filter: none;
  }

  :global(.group:is(:hover, :focus-visible)) .article-thumbnail::after {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .article-cover,
    .article-thumbnail::after {
      transition-duration: 0.01ms;
    }
  }
</style>
