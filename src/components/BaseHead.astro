---
import '../styles/global.css';
import displayFontUrl from '@fontsource/noto-serif/files/noto-serif-latin-700-normal.woff2?url';
import type { ImageMetadata } from 'astro';
import { serializeJsonLd } from '../utils/json-ld';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string | null;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  image = null,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  noindex = false,
} = Astro.props;

const socialImage = image || '/og-image.png';
const isDefaultImage = socialImage === '/og-image.png';
const imageUrl = new URL(
  typeof socialImage === 'string' ? socialImage : socialImage.src,
  Astro.site,
).href;
const socialImageAlt =
  imageAlt ??
  (isDefaultImage
    ? 'Altivo Tecnologia - opte por pensar altivo. Mapeie, personalize, e cresça.'
    : title);
const imageWidth = isDefaultImage
  ? 1200
  : typeof socialImage === 'object'
    ? socialImage.width
    : undefined;
const imageHeight = isDefaultImage
  ? 630
  : typeof socialImage === 'object'
    ? socialImage.height
    : undefined;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- <Font cssVariable="Inter" preload /> -->

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex,follow" />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="pt_BR" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={socialImageAlt} />
{imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
{imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
{isDefaultImage && <meta property="og:image:type" content="image/png" />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={socialImageAlt} />

{
  !noindex && Astro.site && (
    <script
      type="application/ld+json"
      set:html={serializeJsonLd([
        {
          '@context': 'https://schema.org',
          '@type': 'Organization',
          name: SITE_TITLE,
          url: Astro.site.href,
          logo: new URL('/favicon.svg', Astro.site).href,
          sameAs: ['https://instagram.com/altivo.tec/'],
        },
        {
          '@context': 'https://schema.org',
          '@type': 'WebSite',
          name: SITE_TITLE,
          url: Astro.site.href,
          inLanguage: 'pt-BR',
        },
      ])}
    />
  )
}

<!-- Article Specific Meta -->
{
  type === 'article' && publishedTime && (
    <>
      <meta property="article:published_time" content={publishedTime.toISOString()} />
      {author && <meta property="article:author" content={author} />}
      {modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime.toISOString()} />
      )}
    </>
  )
}
